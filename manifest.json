{
  "manifest_version": 3,
  "name": "Night Shift",
  "version": "1.0",

  "description": "Adds dark mode to various sites for free",

  "icons": {
    "48": "icons/nightshift-logo.svg",
    "96": "icons/nightshift-logo.svg"
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "nightshift@mozilla.org",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["nightshift.js"]
    }
  ]
}