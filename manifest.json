{
  "manifest_version": 3,
  "name": "Night Shift",
  "version": "1.0",

  "description": "Adds dark mode to various sites for free",
  "permissions": ["activeTab", "scripting", "storage"],
  "icons": {
    "48": "icons/nightshiftlogo.svg",
    "96": "icons/nightshiftlogo.svg"
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "nightshift@mozilla.org",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },

  "action": {
    "default_popup": "popup/settings.html"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["nightshift.js"],
      "css": ["darkmode.css"]
    }
  ]
}